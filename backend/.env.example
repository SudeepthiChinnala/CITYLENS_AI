# Copy this file to backend/.env and fill the IDs and PBKDF2 password hashes.
# Generate a salted hash in the project virtualenv:
#   python -c "from backend.auth import hash_password; print(hash_password('choose-a-password'))"
CITYLENS_CITIZEN_ID=CIT-001
CITYLENS_CITIZEN_PASSWORD_HASH=
CITYLENS_ADMIN_ID=ADMIN-001
CITYLENS_ADMIN_PASSWORD_HASH=
CITYLENS_SESSION_TTL_SECONDS=28800

# Optional public Overpass API settings for Admin-triggered impact estimates.
CITYLENS_OVERPASS_URL=https://overpass-api.de/api/interpreter
CITYLENS_OVERPASS_TIMEOUT_SECONDS=10
CITYLENS_OVERPASS_MIN_INTERVAL_SECONDS=1.5
CITYLENS_IMPACT_RADIUS_METERS=500
CITYLENS_IMPACT_CACHE_DAYS=30
CITYLENS_IMPACT_FAILURE_CACHE_SECONDS=900
CITYLENS_RECURRENCE_RADIUS_METERS=500
CITYLENS_RECURRENCE_WINDOW_DAYS=365
